{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" }
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "files": {
    "includes": [
      "packages/**/*.ts",
      "apps/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}",
      "*.json",
      "packages/**/*.json",
      "apps/**/*.json",
      "examples/**/*.json",
      "!packages/storage/src/migrations",
      "!apps/web/dist"
    ]
  }
}
