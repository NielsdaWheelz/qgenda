{
  "name": "qgenda",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "solve": "bun run packages/core/src/cli/main.ts",
    "dev": "bun run --filter @qgenda/web dev",
    "build": "bun run --filter @qgenda/web build",
    "start": "bun run --filter @qgenda/web start",
    "preflight": "bun run scripts/preflight.ts",
    "db:generate": "drizzle-kit generate --config packages/storage/drizzle.config.ts",
    "db:check": "drizzle-kit check --config packages/storage/drizzle.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test",
    "test:e2e": "bun run build && bun test tests/web/e2e.test.ts",
    "check": "biome check . && tsc --noEmit && bun run preflight && bun run db:check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@happy-dom/global-registrator": "^20.10.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.3",
    "happy-dom": "^20.10.6",
    "hono": "^4.12.25",
    "playwright": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  }
}
